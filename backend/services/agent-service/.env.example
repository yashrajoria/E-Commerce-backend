# Environment Configuration for Agent Service

# Service Configuration
ENVIRONMENT=development
LOG_LEVEL=info

# API Server
HOST=0.0.0.0
PORT=8000

# Tool HTTP calls go through the api-gateway, matching every other service
TOOL_API_BASE_URL=http://api-gateway:8080

# BFF Service Configuration (BFF's actual port is 8088, not 8080)
BFF_BASE_URL=http://bff-service:8088
BFF_TIMEOUT=15

# LLM Service Configuration
LLM_SERVICE_URL=http://ollama:11434/api/chat
LLM_MODEL=qwen2.5:7b
LLM_TIMEOUT=30

# Concurrency Settings — actual var read by app/core/config.py
MAX_CONCURRENT_TOOLS=5
MAX_HISTORY_TURNS=10
TOOL_TIMEOUT=20

# Postgres — reuses the same root backend/.env values every other service
# connects with. Only needed for the agent_audit_log table.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ecommerce
