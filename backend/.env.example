JWT_SECRET=JWT_SECRET_KEY
POSTGRES_USER=postgres
POSTGRES_PASSWORD=PASSWORD
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ecommerce
POSTGRES_URL=postgresql://postgres:PASSWORD@postgres:5432/ecommerce
SMTP_EMAIL=SMTP_EMAIL_ADDRESS
SMTP_PASSWORD=SMTP_EMAIL_PASSWORD
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
REDIS_URL=redis:6379
PRODUCT_SERVICE_URL=http://product-service:8082
STRIPE_API_KEY=stripe_api_key
STRIPE_WEBHOOK_SECRET=stripe_webhook_secret
STORE_CURRENCY=USD
# Optional override for shipping-service. If empty, embedded default rates are used.
SHIPPING_RATES_FILE=
COOKIE_DOMAIN=
COOKIE_CROSS_ORIGIN=true
# AWS settings
AWS_USE_SECRETS=true
AWS_REGION=us-east-1
# AWS credentials are best provided via IAM roles or CI secrets. Leave blank if using instance/profile/OIDC.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET_IMAGES=ecommerce-product-images
AWS_S3_BUCKET=shopswift
AWS_S3_PREFIX=products/
ASSET_PUBLIC_BASE_URL=
AWS_CLOUDFRONT_DOMAIN=
# SNS Topics (set to real ARNs in AWS)
ORDER_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:order-events
PAYMENT_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:payment-events
AUTH_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:auth-events
# SQS Queues (set to real SQS URLs)
CHECKOUT_QUEUE_URL=
PAYMENT_EVENTS_QUEUE_URL=
PAYMENT_REQUEST_QUEUE_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/payment-request-queue
NOTIFICATION_SQS_QUEUE_URL=http://localstack:4566/000000000000/notification-queue
# DynamoDB
DYNAMODB_PRODUCTS_TABLE=Products
DYNAMODB_INVENTORY_TABLE=Inventory
CLOUDWATCH_ENABLED=true
