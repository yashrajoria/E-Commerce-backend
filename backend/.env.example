JWT_SECRET=JWT_SECRET_KEY
POSTGRES_USER=postgres
POSTGRES_PASSWORD=PASSWORD
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ecommerce
POSTGRES_URL=postgresql://postgres:PASSWORD@postgres:5432/ecommerce
ALLOW_AUTO_MIGRATE=true
# First admin bootstrap (identity-service). Creates a verified admin only when no admin exists.
# Password must meet policy: 8+ chars, upper, lower, number, special.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe1!
ADMIN_NAME=Administrator
SMTP_EMAIL=SMTP_EMAIL_ADDRESS
SMTP_PASSWORD=SMTP_EMAIL_PASSWORD
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
REDIS_URL=redis://redis:6379
# Shared mesh credential for service→service calls (/products/internal/*, inventory reserve/release/…).
# Generate with: openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=change-me-to-a-long-random-secret
PRODUCT_SERVICE_URL=http://catalog-service:8082
AUTH_SERVICE_URL=http://identity-service:8081
USER_SERVICE_URL=http://identity-service:8081
# Comma-separated CIDRs of reverse proxies allowed to set X-Forwarded-For on
# api-gateway. Leave unset when nothing sits in front of the gateway
# container — gin then trusts no forwarded header, so ClientIP() can't be
# spoofed by a client to dodge rate limiting.
TRUSTED_PROXIES=
STRIPE_API_KEY=stripe_api_key
STRIPE_WEBHOOK_SECRET=stripe_webhook_secret
STORE_CURRENCY=USD
# Storefront origin for Stripe checkout success/cancel (admin runs on :3000).
FRONTEND_URL=http://localhost:3001
COOKIE_DOMAIN=
COOKIE_CROSS_ORIGIN=true
GIN_MODE=release
# AWS settings
AWS_USE_SECRETS=true
AWS_REGION=us-east-1
USE_LOCALSTACK=true
LOCALSTACK_ENDPOINT=http://localstack:4566
# AWS credentials are best provided via IAM roles or CI secrets. Leave blank if using instance/profile/OIDC.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET_IMAGES=ecommerce-product-images
AWS_S3_BUCKET=shopswift
AWS_S3_PREFIX=products/
ASSET_PUBLIC_BASE_URL=
AWS_CLOUDFRONT_DOMAIN=
# SNS Topics (set to real ARNs in AWS)
ORDER_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:order-events
PAYMENT_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:payment-events
AUTH_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:auth-events
NOTIFICATION_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:notification-events
# SQS Queues (set to real SQS URLs)
CHECKOUT_QUEUE_URL=http://localstack:4566/queue/us-east-1/000000000000/order-processing-queue
PAYMENT_EVENTS_QUEUE_URL=http://localstack:4566/queue/us-east-1/000000000000/payment-events-queue
PAYMENT_REQUEST_QUEUE_URL=http://localstack:4566/queue/us-east-1/000000000000/payment-request-queue
NOTIFICATION_SQS_QUEUE_URL=http://localstack:4566/queue/us-east-1/000000000000/notification-queue
# catalog-service Postgres role in production (blank = shared postgres user locally)
CATALOG_DB_USER=
CATALOG_DB_PASSWORD=
CLOUDWATCH_ENABLED=false

# --- OpenTelemetry (local tracing) ---
# Leave unset to disable tracing entirely (services start with no-op telemetry).
# For local Jaeger (docker run on the compose network, see docs/backup-restore-runbook.md
# or backend/tools/loadtest/README.md sibling notes):
#   docker run -d --name jaeger --network <project>_ecommerce-network \
#     -p 16686:16686 -p 4318:4318 -e COLLECTOR_OTLP_ENABLED=true \
#     jaegertracing/all-in-one:1.57
# Then inside compose (services reach it by container name):
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
DEPLOY_ENV=local
