JWT_SECRET=JWT_SECRET_KEY
POSTGRES_USER=postgres
POSTGRES_PASSWORD=PASSWORD
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ecommerce
POSTGRES_URL=postgresql://postgres:PASSWORD@postgres:5432/ecommerce
ALLOW_AUTO_MIGRATE=true
# First admin bootstrap (identity-service). Creates a verified admin only when no admin exists.
# Password must meet policy: 8+ chars, upper, lower, number, special.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe1!
ADMIN_NAME=Administrator
SMTP_EMAIL=SMTP_EMAIL_ADDRESS
SMTP_PASSWORD=SMTP_EMAIL_PASSWORD
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
REDIS_URL=redis://redis:6379
# Shared mesh credential for service→service calls (/products/internal/*, inventory reserve/release/…).
# Generate with: openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=change-me-to-a-long-random-secret
PRODUCT_SERVICE_URL=http://catalog-service:8082
AUTH_SERVICE_URL=http://identity-service:8081
USER_SERVICE_URL=http://identity-service:8081
# Comma-separated CIDRs of reverse proxies allowed to set X-Forwarded-For on
# api-gateway. Leave unset when nothing sits in front of the gateway
# container — gin then trusts no forwarded header, so ClientIP() can't be
# spoofed by a client to dodge rate limiting.
TRUSTED_PROXIES=
STRIPE_API_KEY=stripe_api_key
STRIPE_WEBHOOK_SECRET=stripe_webhook_secret
STORE_CURRENCY=USD
# Storefront origin for Stripe checkout success/cancel (admin runs on :3000).
FRONTEND_URL=http://localhost:3001
COOKIE_DOMAIN=
COOKIE_CROSS_ORIGIN=true
GIN_MODE=release
# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key
SUPABASE_STORAGE_BUCKET=shopswift
# Local storage fallback directory (when SUPABASE_URL is empty)
LOCAL_STORAGE_DIR=./uploads

# Messaging Queues & Topics (PostgreSQL Queues)
ORDER_SNS_TOPIC_ARN=order-events
PAYMENT_SNS_TOPIC_ARN=payment-events
AUTH_SNS_TOPIC_ARN=auth-events
NOTIFICATION_SNS_TOPIC_ARN=notification-queue
CHECKOUT_QUEUE_URL=order-processing-queue
PAYMENT_EVENTS_QUEUE_URL=payment-events-queue
PAYMENT_REQUEST_QUEUE_URL=payment-request-queue
NOTIFICATION_SQS_QUEUE_URL=notification-queue
# catalog-service Postgres role in production (blank = shared postgres user locally)
CATALOG_DB_USER=
CATALOG_DB_PASSWORD=

# --- OpenTelemetry (local tracing) ---
# Leave unset to disable tracing entirely (services start with no-op telemetry).
# For local Jaeger (docker run on the compose network, see docs/backup-restore-runbook.md
# or backend/tools/loadtest/README.md sibling notes):
#   docker run -d --name jaeger --network <project>_ecommerce-network \
#     -p 16686:16686 -p 4318:4318 -e COLLECTOR_OTLP_ENABLED=true \
#     jaegertracing/all-in-one:1.57
# Then inside compose (services reach it by container name):
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
DEPLOY_ENV=local

# --- AI Copilot & LLM Engine ---
# Provider options: 'auto' (fallback chain: Gemini -> OpenAI -> Ollama), 'gemini', 'openai', or 'ollama'
LLM_PROVIDER=auto
GEMINI_API_KEY=
OPENAI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://ollama:11434
LLM_SERVICE_URL=http://ollama:11434/api/chat

